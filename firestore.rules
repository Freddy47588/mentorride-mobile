rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasValidOdometer(data) {
      return data.currentOdometer is int && data.currentOdometer >= 0;
    }

    function preservesOdometer() {
      return hasValidOdometer(request.resource.data)
        && (
          !('currentOdometer' in resource.data)
          || !(resource.data.currentOdometer is int)
          || request.resource.data.currentOdometer
            >= resource.data.currentOdometer
        );
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /vehicles/{vehicleId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && hasValidOdometer(request.resource.data);
        allow update: if isOwner(uid) && preservesOdometer();
      }

      match /vehicles/{vehicleId}/service_records/{recordId} {
        allow read, write: if isOwner(uid);
      }

      match /vehicles/{vehicleId}/service_schedules/{scheduleId} {
        allow read, write: if isOwner(uid);
      }

      match /vehicles/{vehicleId}/odometer_logs/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.odometer is int
          && request.resource.data.odometer >= 0
          && request.resource.data.recordedAt is timestamp
          && request.resource.data.source in [
            'manual_update',
            'service_record'
          ];
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
